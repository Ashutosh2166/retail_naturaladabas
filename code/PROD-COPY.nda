* >Natural Source Code: PROD-COPY
* RETAILCORE - PRODUCT DATA DEFINITIONS
* SHARED BY ALL PRODUCT-RELATED PROGRAMS
* CREATED: 1998-03-22
* MODIFIED: 2008-06-15 - ADDED PRODUCT ATTRIBUTES
* MODIFIED: 2015-02-20 - ADDED WEB-ENABLED FLAG
* MODIFIED: 2020-08-10 - ADDED PRODUCT DIMENSIONS
* -------------------------------------------------------
*
* PRODUCT MASTER RECORD
*
1 PRODUCT-DATA
  2 PROD-ID               (N8)    /* INTERNAL PRODUCT ID */
  2 PROD-SKU              (A15)   /* STOCK KEEPING UNIT */
  2 ITEM-NO               (A12)   /* LEGACY ITEM NUMBER - STILL USED IN SOME MODULES */
  2 ARTICLE-NO            (A10)   /* EUROPEAN ARTICLE NUMBER - LEGACY */
  2 PROD-NAME             (A60)
  2 PROD-SHORT-DESC       (A30)
  2 PROD-LONG-DESC        (A200)
  2 PROD-STATUS           (A1)    /* A=ACTIVE I=INACTIVE D=DISCONTINUED C=CLEARANCE */
  2 PROD-TYPE             (A2)    /* PH=PHYSICAL DG=DIGITAL SV=SERVICE GC=GIFT CARD */
  2 PROD-BRAND            (A30)
  2 PROD-MANUFACTURER     (A40)
  2 PROD-MFG-PART-NO      (A20)
  2 PROD-UPC              (A13)   /* UNIVERSAL PRODUCT CODE */
  2 PROD-EAN              (A13)   /* EUROPEAN ARTICLE NUMBER */
*
* PRODUCT CATEGORIZATION
*
1 PRODUCT-CATEGORY
  2 PROD-DEPT             (A4)    /* DEPARTMENT CODE */
  2 PROD-DEPT-NAME        (A30)
  2 PROD-CLASS            (A4)    /* CLASS CODE */
  2 PROD-CLASS-NAME       (A30)
  2 PROD-SUBCLASS         (A4)    /* SUBCLASS CODE */
  2 PROD-SUBCLASS-NAME    (A30)
  2 PROD-CATEGORY-PATH    (A60)   /* DEPT/CLASS/SUBCLASS */
*
* PRODUCT ATTRIBUTES
*
1 PRODUCT-ATTRIBUTES
  2 PROD-COLOR            (A20)
  2 PROD-SIZE             (A10)
  2 PROD-WEIGHT           (N7.3)  /* IN KG */
  2 PROD-WEIGHT-UOM       (A3)    /* KG LB OZ */
  2 PROD-LENGTH           (N7.2)  /* IN CM */
  2 PROD-WIDTH            (N7.2)
  2 PROD-HEIGHT           (N7.2)
  2 PROD-DIMENSION-UOM    (A2)    /* CM IN */
  2 PROD-PERISHABLE       (A1)    /* Y N */
  2 PROD-HAZARDOUS        (A1)    /* Y N */
  2 PROD-FRAGILE          (A1)    /* Y N */
  2 PROD-AGE-RESTRICT     (N2)    /* MIN AGE 0=NONE */
  2 PROD-SEASONAL         (A1)    /* Y N */
  2 PROD-SEASON-CODE      (A4)    /* SP SU FA WI */
*
* PRODUCT PRICING REFERENCE
*
1 PRODUCT-PRICE-REF
  2 PROD-BASE-COST        (N9.2)  /* COST FROM SUPPLIER */
  2 PROD-BASE-PRICE       (N9.2)  /* STANDARD RETAIL PRICE */
  2 PROD-MSRP             (N9.2)  /* MANUFACTURER SUGGESTED PRICE */
  2 PROD-MIN-PRICE        (N9.2)  /* MINIMUM ALLOWABLE PRICE */
  2 PROD-TAX-CODE         (A4)    /* TAX CATEGORY */
  2 PROD-TAX-RATE         (N5.4)  /* TAX PERCENTAGE */
  2 PROD-CURRENCY         (A3)    /* USD EUR GBP */
*
* PRODUCT WEB FIELDS
*
1 PRODUCT-WEB
  2 PROD-WEB-ENABLED      (A1)    /* Y N */
  2 PROD-WEB-VISIBLE      (A1)    /* Y N */
  2 PROD-WEB-URL          (A100)
  2 PROD-IMAGE-URL        (A100)
*
* PRODUCT LIFECYCLE
*
1 PRODUCT-LIFECYCLE
  2 PROD-INTRO-DATE       (D)     /* INTRODUCTION DATE */
  2 PROD-DISCO-DATE       (D)     /* DISCONTINUATION DATE */
  2 PROD-CLEARANCE-DATE   (D)     /* CLEARANCE START DATE */
  2 PROD-LAST-RECEIPT     (D)     /* LAST RECEIPT DATE */
  2 PROD-LAST-SOLD        (D)     /* LAST SOLD DATE */
*
* PRODUCT SUPPLIER REFERENCE
*
1 PRODUCT-SUPPLIER-REF
  2 PROD-PRIMARY-SUPP     (N6)    /* PRIMARY SUPPLIER ID */
  2 PROD-SECONDARY-SUPP   (N6)    /* SECONDARY SUPPLIER */
  2 PROD-LEAD-TIME        (N3)    /* LEAD TIME IN DAYS */
  2 PROD-MIN-ORDER-QTY    (N6)    /* MINIMUM ORDER QUANTITY */
  2 PROD-REORDER-QTY      (N6)    /* STANDARD REORDER QUANTITY */
*
* PRODUCT AUDIT
*
1 PRODUCT-AUDIT
  2 PROD-CREATED-DATE     (D)
  2 PROD-CREATED-BY       (A8)
  2 PROD-MODIFIED-DATE    (D)
  2 PROD-MODIFIED-BY      (A8)
*
* PRODUCT SEARCH PARAMETERS
*
1 PRODUCT-SEARCH
  2 PS-SEARCH-ID          (N8)
  2 PS-SEARCH-SKU         (A15)
  2 PS-SEARCH-NAME        (A60)
  2 PS-SEARCH-DEPT        (A4)
  2 PS-SEARCH-CLASS       (A4)
  2 PS-SEARCH-STATUS      (A1)
  2 PS-SEARCH-BRAND       (A30)
  2 PS-SEARCH-SUPP        (N6)
  2 PS-FOUND-FLAG         (A1)
  2 PS-RECORD-COUNT       (N5)
*
END-DEFINE
