* >Natural Source Code: PRODVAL
* SUBPROGRAM: PRODVAL - PRODUCT VALIDATION
* DESCRIPTION: VALIDATES ALL PRODUCT FIELDS
* LIBRARY: RETAILCORE
* CREATED: 1998-07-10  T. ANDERSON
* MODIFIED: 2006-11-20 - ADDED SKU FORMAT CHECK
* MODIFIED: 2014-04-18 - ADDED SUPPLIER VALIDATION
* MODIFIED: 2021-03-05 - ADDED PRICE MARGIN CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PRODUCT-DATA
    2 P-PD-ID             (N8)
    2 P-PD-SKU            (A15)
    2 P-PD-NAME           (A60)
    2 P-PD-STATUS         (A1)
    2 P-PD-TYPE           (A2)
    2 P-PD-BRAND          (A30)
    2 P-PD-UPC            (A13)
  1 P-PRODUCT-CATEGORY
    2 P-PC-DEPT           (A4)
    2 P-PC-CLASS          (A4)
    2 P-PC-SUBCLASS       (A4)
  1 P-PRODUCT-ATTRIBUTES
    2 P-PA-COLOR          (A20)
    2 P-PA-SIZE           (A10)
    2 P-PA-WEIGHT         (N7.3)
    2 P-PA-PERISHABLE     (A1)
    2 P-PA-HAZARDOUS      (A1)
  1 P-PRODUCT-PRICE
    2 P-PP-BASE-COST      (N9.2)
    2 P-PP-BASE-PRICE     (N9.2)
    2 P-PP-MSRP           (N9.2)
    2 P-PP-MIN-PRICE      (N9.2)
    2 P-PP-TAX-CODE       (A4)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #VAL-FLAG             (A1)
  1 #VAL-MSG              (A60)
  1 #DUP-COUNT            (N5)
  1 #MARGIN-PCT           (N5.2)
  1 #SUPP-FOUND           (A1)
  1 #SUPP-MSG             (A60)
*
  1 PROD-DUP-VIEW VIEW OF PRODUCT-FILE
    2 PR-ID                (N8)
    2 PR-SKU               (A15)
END-DEFINE
*
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
* VALIDATE SKU
IF P-PD-SKU = ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'SKU IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
CALLNAT 'VALU' 'ALNM' P-PD-SKU #VAL-FLAG #VAL-MSG
IF #VAL-FLAG NE 'Y'
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'SKU CONTAINS INVALID CHARACTERS' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK FOR DUPLICATE SKU
* MODIFIED 2006-11-20
FIND NUMBER PROD-DUP-VIEW WITH PR-SKU = P-PD-SKU
  MOVE *NUMBER TO #DUP-COUNT
END-FIND
IF P-PD-ID > 0
  IF #DUP-COUNT > 1
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DUPLICATE SKU EXISTS' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
ELSE
  IF #DUP-COUNT > 0
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'SKU ALREADY EXISTS' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
END-IF
*
* VALIDATE NAME
IF P-PD-NAME = ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'PRODUCT NAME IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE TYPE
IF P-PD-TYPE NE 'PH' AND P-PD-TYPE NE 'DG'
    AND P-PD-TYPE NE 'SV' AND P-PD-TYPE NE 'GC'
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'INVALID PRODUCT TYPE (PH/DG/SV/GC)' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE DEPARTMENT
IF P-PC-DEPT = ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'DEPARTMENT IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE PRICING
IF P-PP-BASE-PRICE <= 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'BASE PRICE MUST BE GREATER THAN ZERO' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
IF P-PP-BASE-COST <= 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'BASE COST MUST BE GREATER THAN ZERO' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
IF P-PP-MIN-PRICE > P-PP-BASE-PRICE
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'MIN PRICE CANNOT EXCEED BASE PRICE' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK MARGIN - WARN IF BELOW 10%
* MODIFIED 2021-03-05
IF P-PP-BASE-COST > 0
  COMPUTE #MARGIN-PCT = ((P-PP-BASE-PRICE - P-PP-BASE-COST)
    / P-PP-BASE-PRICE) * 100
  IF #MARGIN-PCT < 10
    * WARNING ONLY - STILL ALLOW
    MOVE 'WARNING: MARGIN BELOW 10%' TO P-ERROR-MSG
    * KEEP VALID FLAG AS Y - JUST A WARNING
  END-IF
END-IF
*
* VALIDATE FLAGS
IF P-PA-PERISHABLE NE 'Y' AND P-PA-PERISHABLE NE 'N'
    AND P-PA-PERISHABLE NE ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'PERISHABLE FLAG MUST BE Y OR N' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
IF P-PA-HAZARDOUS NE 'Y' AND P-PA-HAZARDOUS NE 'N'
    AND P-PA-HAZARDOUS NE ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'HAZARDOUS FLAG MUST BE Y OR N' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
MOVE 'Y' TO P-VALID-FLAG
*
END
