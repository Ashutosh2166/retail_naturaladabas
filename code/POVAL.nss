* >Natural Source Code: POVAL
* SUBPROGRAM: POVAL - PURCHASE ORDER STATUS MANAGEMENT
* DESCRIPTION: MANAGES PO LIFECYCLE STATUS TRANSITIONS
*              DRAFT->SUBMIT->APPROVE->SHIP->PARTIAL/RECEIVE->CLOSE
*              OR CANCEL AT ANY POINT
* LIBRARY: RETAILCORE
* ADABAS FILE: 131 (PO-HEADER)
* CREATED: 2001-10-15  A. GARCIA
* MODIFIED: 2009-06-22 - ADDED APPROVAL WORKFLOW
* MODIFIED: 2016-02-10 - ADDED PARTIAL RECEIPT
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PO-ID               (N10)
  1 P-ACTION              (A4)    /* SUBM APRV SHIP RECV CLOS CANC */
  1 P-USER                (A8)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #CURRENT-STATUS       (A2)
  1 #NEW-STATUS           (A2)
  1 #VALID                (A1)
  1 #ORD-STR              (A15)
*
  1 POS-VIEW VIEW OF PO-HEADER-FILE
    2 POS-ID               (N10)
    2 POS-STATUS           (A2)
    2 POS-TOTAL-AMT        (N11.2)
    2 POS-APPROVED-BY      (A8)
    2 POS-APPROVED-DATE    (D)
    2 POS-MODIFIED-BY      (A8)
    2 POS-MODIFIED-DATE    (D)
END-DEFINE
*
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
FIND POS-VIEW WITH POS-ID = P-PO-ID
  IF NO RECORDS FOUND
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PURCHASE ORDER NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
  MOVE POS-STATUS TO #CURRENT-STATUS
  ESCAPE BOTTOM
END-FIND
*
* DETERMINE NEW STATUS
MOVE 'N' TO #VALID
DECIDE ON FIRST VALUE OF P-ACTION
  VALUE 'SUBM'
    IF #CURRENT-STATUS = 'DR'
      MOVE 'SB' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'APRV'
    IF #CURRENT-STATUS = 'SB'
      MOVE 'AP' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'SHIP'
    IF #CURRENT-STATUS = 'AP'
      MOVE 'SH' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'RECV'
    IF #CURRENT-STATUS = 'SH' OR #CURRENT-STATUS = 'PR'
      MOVE 'RC' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'PART'
    IF #CURRENT-STATUS = 'SH' OR #CURRENT-STATUS = 'PR'
      MOVE 'PR' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'CLOS'
    IF #CURRENT-STATUS = 'RC'
      MOVE 'CL' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'CANC'
    IF #CURRENT-STATUS NE 'CL' AND #CURRENT-STATUS NE 'CA'
      MOVE 'CA' TO #NEW-STATUS
      MOVE 'Y' TO #VALID
    END-IF
  NONE VALUE
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'INVALID PO ACTION' TO P-ERROR-MSG
    ESCAPE ROUTINE
END-DECIDE
*
IF #VALID NE 'Y'
  MOVE 'N' TO P-VALID-FLAG
  COMPRESS 'INVALID PO STATUS TRANSITION:' #CURRENT-STATUS
    '->' P-ACTION INTO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* APPLY STATUS CHANGE
FIND POS-VIEW WITH POS-ID = P-PO-ID
  GET POS-VIEW *ISN (HOLD)
  MOVE #NEW-STATUS TO POS-STATUS
  IF P-ACTION = 'APRV'
    MOVE P-USER TO POS-APPROVED-BY
    MOVE *DATX TO POS-APPROVED-DATE
  END-IF
  MOVE P-USER TO POS-MODIFIED-BY
  MOVE *DATX TO POS-MODIFIED-DATE
  UPDATE POS-VIEW
  ESCAPE BOTTOM
END-FIND
*
END OF TRANSACTION
*
* AUDIT
MOVE P-PO-ID TO #ORD-STR
CALLNAT 'AUDITN' 'PO' #ORD-STR 'U' P-ACTION
  #CURRENT-STATUS #NEW-STATUS 'PO STATUS CHANGE'
*
END
