* >Natural Source Code: ORDPRICE2
* SUBPROGRAM: ORDPRICE2 - ORDER LINE PRICING (NEW VERSION)
* DESCRIPTION: COMPREHENSIVE PRICING ENGINE FOR ORDER LINES
*              REPLACES ORDPRICE - HANDLES ALL PRICE TIERS
*              BASE -> STORE -> CUSTOMER -> SEASONAL ->
*              PROMOTION -> COUPON -> QTY DISCOUNT -> TAX
* LIBRARY: RETAILCORE
* CREATED: 2011-03-10  S. MARTINEZ
* MODIFIED: 2015-08-20 - ADDED CLEARANCE PRICING
* MODIFIED: 2019-02-15 - ADDED MEMBER DISCOUNT
* MODIFIED: 2022-11-10 - ADDED MARGIN PROTECTION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PRICE-WORK
    2 P-PROD-ID            (N8)
    2 P-SKU                (A15)
    2 P-STORE-ID           (N4)
    2 P-CUST-ID            (N8)
    2 P-CUST-TYPE          (A2)
    2 P-QTY                (N6)
    2 P-BASE-PRICE         (N9.2)
    2 P-STORE-PRICE        (N9.2)
    2 P-CUST-PRICE         (N9.2)
    2 P-SEASONAL-PRICE     (N9.2)
    2 P-PROMO-PRICE        (N9.2)
    2 P-COUPON-DISCOUNT    (N9.2)
    2 P-QTY-DISCOUNT       (N9.2)
    2 P-MEMBER-DISCOUNT    (N9.2)
    2 P-CLEARANCE-PRICE    (N9.2)
    2 P-FINAL-UNIT-PRICE   (N9.2)
    2 P-TAX-RATE           (N5.4)
    2 P-TAX-AMT            (N9.2)
    2 P-FINAL-PRICE        (N9.2)
    2 P-DISCOUNT-TOTAL     (N9.2)
    2 P-MARGIN             (N9.2)
    2 P-MARGIN-PCT         (N5.2)
    2 P-PRICE-SOURCE       (A2)
    2 P-PROMO-APPLIED      (A1)
    2 P-COUPON-APPLIED     (A1)
  1 P-VALID-FLAG           (A1)
  1 P-ERROR-MSG            (A60)
*
LOCAL
  1 #WORK-PRICE            (N9.2)
  1 #MIN-PRICE             (N9.2)
  1 #COST-PRICE            (N9.2)
  1 #MIN-MARGIN-PCT        (N5.2) INIT <5.00>
  1 #FOUND                 (A1)
  1 #TODAY                 (D)
  1 #CONFIG-VALUE          (A80)
  1 #CONFIG-NUM            (N11.2)
  1 #CONFIG-DATE           (D)
  1 #CONFIG-FLAG           (A1)
  1 #CONFIG-FOUND          (A1)
*
* MEMBER DISCOUNT RATES BY TIER
  1 #MEMBER-DISC-BRONZE    (N5.2)  INIT <2.00>
  1 #MEMBER-DISC-SILVER    (N5.2)  INIT <5.00>
  1 #MEMBER-DISC-GOLD      (N5.2)  INIT <8.00>
  1 #MEMBER-DISC-PLAT      (N5.2)  INIT <12.00>
  1 #MEMBER-DISC-RATE      (N5.2)
*
* QTY DISCOUNT TIERS
  1 #QTY-TIER1-MIN         (N6)    INIT <10>
  1 #QTY-TIER1-DISC        (N5.2)  INIT <3.00>
  1 #QTY-TIER2-MIN         (N6)    INIT <50>
  1 #QTY-TIER2-DISC        (N5.2)  INIT <5.00>
  1 #QTY-TIER3-MIN         (N6)    INIT <100>
  1 #QTY-TIER3-DISC        (N5.2)  INIT <8.00>
  1 #QTY-TIER4-MIN         (N6)    INIT <500>
  1 #QTY-TIER4-DISC        (N5.2)  INIT <12.00>
*
  1 PR2-VIEW VIEW OF PRODUCT-FILE
    2 PR2-ID               (N8)
    2 PR2-BASE-PRICE       (N9.2)
    2 PR2-MIN-PRICE        (N9.2)
    2 PR2-COST-PRICE       (N9.2)
    2 PR2-TAX-CODE         (A4)
    2 PR2-STATUS           (A1)
*
  1 SP2-VIEW VIEW OF STORE-PRICE-FILE
    2 SP2-PROD-ID          (N8)
    2 SP2-STORE-ID         (N4)
    2 SP2-PRICE            (N9.2)
    2 SP2-EFF-FROM         (D)
    2 SP2-EFF-TO           (D)
*
  1 CU2-VIEW VIEW OF CUSTOMER-FILE
    2 CU2-ID               (N8)
    2 CU2-TYPE             (A2)
    2 CU2-LOYALTY-TIER     (A1)
*
  1 TX-VIEW VIEW OF TAX-RATE-FILE
    2 TX-CODE              (A4)
    2 TX-RATE              (N5.4)
    2 TX-DESCRIPTION       (A40)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
RESET P-STORE-PRICE
RESET P-CUST-PRICE
RESET P-SEASONAL-PRICE
RESET P-PROMO-PRICE
RESET P-COUPON-DISCOUNT
RESET P-QTY-DISCOUNT
RESET P-MEMBER-DISCOUNT
RESET P-CLEARANCE-PRICE
RESET P-DISCOUNT-TOTAL
MOVE 'N' TO P-PROMO-APPLIED
MOVE 'N' TO P-COUPON-APPLIED
MOVE 'BA' TO P-PRICE-SOURCE
*
* -------------------------------------------------------
* STEP 1: GET BASE PRICE FROM PRODUCT
* -------------------------------------------------------
FIND PR2-VIEW WITH PR2-ID = P-PROD-ID
  IF NO RECORDS FOUND
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PRODUCT NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
  IF PR2-STATUS NE 'A' AND PR2-STATUS NE 'C'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PRODUCT NOT AVAILABLE FOR SALE' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  MOVE PR2-BASE-PRICE TO P-BASE-PRICE
  MOVE PR2-MIN-PRICE  TO #MIN-PRICE
  MOVE PR2-COST-PRICE TO #COST-PRICE
  MOVE PR2-BASE-PRICE TO #WORK-PRICE
  ESCAPE BOTTOM
END-FIND
*
IF P-BASE-PRICE = 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'NO BASE PRICE DEFINED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* STEP 2: CHECK STORE PRICE OVERRIDE
* MODIFIED 2024-06-15 - REFACTORED TO USE STOREPRICE MODULE
* -------------------------------------------------------
IF P-STORE-ID > 0
  1 #STP-PRICE   (N9.2)
  1 #STP-EFF-FROM (D)
  1 #STP-EFF-TO   (D)
  1 #STP-RC       (N4)
  1 #STP-RC-TEXT   (A80)
  CALLNAT 'STOREPRICE' 'GET' P-PROD-ID P-STORE-ID
    #STP-PRICE #STP-EFF-FROM #STP-EFF-TO ' '
    #STP-RC #STP-RC-TEXT
  IF #STP-RC = 0 AND #STP-PRICE > 0
    MOVE #STP-PRICE TO P-STORE-PRICE
    MOVE #STP-PRICE TO #WORK-PRICE
    MOVE 'ST' TO P-PRICE-SOURCE
  END-IF
END-IF
*
* -------------------------------------------------------
* STEP 3: CHECK CUSTOMER-SPECIFIC PRICING
* -------------------------------------------------------
IF P-CUST-ID > 0 AND P-CUST-TYPE = ' '
  * LOOK UP CUSTOMER TYPE IF NOT PROVIDED
  FIND CU2-VIEW WITH CU2-ID = P-CUST-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    MOVE CU2-TYPE TO P-CUST-TYPE
    ESCAPE BOTTOM
  END-FIND
END-IF
*
IF P-CUST-TYPE = 'WH'
  * WHOLESALE: 15% OFF WORKING PRICE
  COMPUTE P-CUST-PRICE = #WORK-PRICE * 0.85
  MOVE P-CUST-PRICE TO #WORK-PRICE
  MOVE 'CU' TO P-PRICE-SOURCE
ELSE IF P-CUST-TYPE = 'CO'
  * CORPORATE: 10% OFF WORKING PRICE
  COMPUTE P-CUST-PRICE = #WORK-PRICE * 0.90
  MOVE P-CUST-PRICE TO #WORK-PRICE
  MOVE 'CU' TO P-PRICE-SOURCE
ELSE IF P-CUST-TYPE = 'EM'
  * EMPLOYEE: 20% OFF BASE PRICE (NOT STORE PRICE)
  COMPUTE P-CUST-PRICE = P-BASE-PRICE * 0.80
  IF P-CUST-PRICE < #WORK-PRICE
    MOVE P-CUST-PRICE TO #WORK-PRICE
    MOVE 'CU' TO P-PRICE-SOURCE
  END-IF
END-IF
END-IF
END-IF
*
* -------------------------------------------------------
* STEP 4: CHECK CLEARANCE PRICING
* MODIFIED 2015-08-20
* -------------------------------------------------------
IF PR2-STATUS = 'C'
  * CLEARANCE: 30% OFF CURRENT WORKING PRICE
  COMPUTE P-CLEARANCE-PRICE = #WORK-PRICE * 0.70
  MOVE P-CLEARANCE-PRICE TO #WORK-PRICE
  MOVE 'CL' TO P-PRICE-SOURCE
END-IF
*
* -------------------------------------------------------
* STEP 5: CHECK ACTIVE PROMOTIONS
* -------------------------------------------------------
CALLNAT 'PROMCALC'
  P-PROD-ID P-SKU P-STORE-ID P-CUST-ID P-QTY
  #WORK-PRICE P-PROMO-PRICE P-PROMO-APPLIED P-VALID-FLAG
  P-ERROR-MSG
*
IF P-PROMO-APPLIED = 'Y' AND P-PROMO-PRICE > 0
  IF P-PROMO-PRICE < #WORK-PRICE
    MOVE P-PROMO-PRICE TO #WORK-PRICE
    MOVE 'PR' TO P-PRICE-SOURCE
  END-IF
END-IF
*
* -------------------------------------------------------
* STEP 6: QUANTITY DISCOUNT
* -------------------------------------------------------
RESET #MEMBER-DISC-RATE
IF P-QTY >= #QTY-TIER4-MIN
  MOVE #QTY-TIER4-DISC TO #MEMBER-DISC-RATE
ELSE IF P-QTY >= #QTY-TIER3-MIN
  MOVE #QTY-TIER3-DISC TO #MEMBER-DISC-RATE
ELSE IF P-QTY >= #QTY-TIER2-MIN
  MOVE #QTY-TIER2-DISC TO #MEMBER-DISC-RATE
ELSE IF P-QTY >= #QTY-TIER1-MIN
  MOVE #QTY-TIER1-DISC TO #MEMBER-DISC-RATE
END-IF
END-IF
END-IF
END-IF
*
IF #MEMBER-DISC-RATE > 0
  COMPUTE P-QTY-DISCOUNT = #WORK-PRICE * P-QTY
    * (#MEMBER-DISC-RATE / 100)
END-IF
*
* -------------------------------------------------------
* STEP 7: MEMBER DISCOUNT
* MODIFIED 2019-02-15
* -------------------------------------------------------
RESET #MEMBER-DISC-RATE
IF P-CUST-ID > 0
  FIND CU2-VIEW WITH CU2-ID = P-CUST-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    DECIDE ON FIRST VALUE OF CU2-LOYALTY-TIER
      VALUE 'B'
        MOVE #MEMBER-DISC-BRONZE TO #MEMBER-DISC-RATE
      VALUE 'S'
        MOVE #MEMBER-DISC-SILVER TO #MEMBER-DISC-RATE
      VALUE 'G'
        MOVE #MEMBER-DISC-GOLD TO #MEMBER-DISC-RATE
      VALUE 'P'
        MOVE #MEMBER-DISC-PLAT TO #MEMBER-DISC-RATE
      NONE VALUE
        IGNORE
    END-DECIDE
    ESCAPE BOTTOM
  END-FIND
  IF #MEMBER-DISC-RATE > 0
    COMPUTE P-MEMBER-DISCOUNT = #WORK-PRICE * P-QTY
      * (#MEMBER-DISC-RATE / 100)
  END-IF
END-IF
*
* -------------------------------------------------------
* STEP 8: CALCULATE FINAL PRICE
* -------------------------------------------------------
MOVE #WORK-PRICE TO P-FINAL-UNIT-PRICE
*
COMPUTE P-DISCOUNT-TOTAL =
  (P-BASE-PRICE * P-QTY)
  - (P-FINAL-UNIT-PRICE * P-QTY)
  + P-QTY-DISCOUNT
  + P-MEMBER-DISCOUNT
  + P-COUPON-DISCOUNT
*
* -------------------------------------------------------
* STEP 9: MARGIN PROTECTION
* MODIFIED 2022-11-10
* -------------------------------------------------------
IF #COST-PRICE > 0
  COMPUTE P-MARGIN = P-FINAL-UNIT-PRICE - #COST-PRICE
  IF P-FINAL-UNIT-PRICE > 0
    COMPUTE P-MARGIN-PCT = (P-MARGIN / P-FINAL-UNIT-PRICE) * 100
  END-IF
  * CHECK MINIMUM MARGIN
  CALLNAT 'CONFIGN' 'MIN.MARGIN.PCT'
    #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
  IF #CONFIG-FOUND = 'Y'
    MOVE #CONFIG-NUM TO #MIN-MARGIN-PCT
  END-IF
  IF P-MARGIN-PCT < #MIN-MARGIN-PCT
    * ADJUST TO MINIMUM MARGIN
    COMPUTE P-FINAL-UNIT-PRICE = #COST-PRICE / (1 - #MIN-MARGIN-PCT / 100)
    * RECALC DISCOUNT
    COMPUTE P-DISCOUNT-TOTAL =
      (P-BASE-PRICE * P-QTY)
      - (P-FINAL-UNIT-PRICE * P-QTY)
    COMPUTE P-MARGIN = P-FINAL-UNIT-PRICE - #COST-PRICE
    COMPUTE P-MARGIN-PCT = (P-MARGIN / P-FINAL-UNIT-PRICE) * 100
  END-IF
END-IF
*
* ENFORCE MINIMUM PRICE
IF #MIN-PRICE > 0 AND P-FINAL-UNIT-PRICE < #MIN-PRICE
  MOVE #MIN-PRICE TO P-FINAL-UNIT-PRICE
  COMPUTE P-DISCOUNT-TOTAL =
    (P-BASE-PRICE * P-QTY) - (P-FINAL-UNIT-PRICE * P-QTY)
END-IF
*
* -------------------------------------------------------
* STEP 10: TAX CALCULATION
* MODIFIED 2024-06-15 - REFACTORED TO USE TAXCALC MODULE
* -------------------------------------------------------
1 #TAXABLE-AMT   (N11.2)
1 #TX-TAX-RATE   (N5.4)
1 #TX-TAX-AMT    (N9.2)
1 #TX-TAX-DETAIL
  2 #TX-STATE-RATE   (N5.4)
  2 #TX-COUNTY-RATE  (N5.4)
  2 #TX-CITY-RATE    (N5.4)
  2 #TX-SPECIAL-RATE (N5.4)
  2 #TX-TOTAL-RATE   (N5.4)
  2 #TX-STATE-AMT    (N9.2)
  2 #TX-COUNTY-AMT   (N9.2)
  2 #TX-CITY-AMT     (N9.2)
  2 #TX-TOTAL-AMT    (N9.2)
1 #TX-RC          (N4)
1 #TX-RC-TEXT     (A80)
1 #CUST-TAX-EXEMPT (A1) INIT <'N'>
*
COMPUTE #TAXABLE-AMT = (P-FINAL-UNIT-PRICE * P-QTY)
  - P-QTY-DISCOUNT - P-MEMBER-DISCOUNT - P-COUPON-DISCOUNT
*
* CALL TAXCALC FOR JURISDICTION-AWARE TAX CALCULATION
CALLNAT 'TAXCALC' PR2-TAX-CODE ' '
  #TAXABLE-AMT #CUST-TAX-EXEMPT
  #TX-TAX-RATE #TX-TAX-AMT #TX-TAX-DETAIL
  #TX-RC #TX-RC-TEXT
*
IF #TX-RC = 0
  MOVE #TX-TAX-RATE TO P-TAX-RATE
  MOVE #TX-TAX-AMT  TO P-TAX-AMT
ELSE
  * FALLBACK TO DEFAULT RATE ON ERROR
  MOVE 0.0825 TO P-TAX-RATE
  COMPUTE P-TAX-AMT = #TAXABLE-AMT * P-TAX-RATE
  CALLNAT 'LOGERR' 340 #TX-RC-TEXT 'W' 'ORDPRC2' *USER
END-IF
*
COMPUTE P-FINAL-PRICE = #TAXABLE-AMT + P-TAX-AMT
*
END
