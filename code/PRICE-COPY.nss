* >Natural Source Code: PRICE-COPY
* RETAILCORE - PRICING AND PROMOTION DATA DEFINITIONS
* SHARED BY ALL PRICING AND PROMOTION PROGRAMS
* CREATED: 1999-01-10
* MODIFIED: 2008-04-20 - ADDED TIERED PRICING
* MODIFIED: 2014-11-15 - ADDED COUPON FIELDS
* MODIFIED: 2019-06-20 - ADDED NON-STACKABLE FLAG
* MODIFIED: 2022-03-10 - ADDED CLEARANCE PRICING
* -------------------------------------------------------
*
* PRICE RECORD
*
1 PRICE-DATA
  2 PRC-PROD-ID           (N8)    /* PRODUCT ID */
  2 PRC-SKU               (A15)   /* SKU */
  2 PRC-TYPE              (A2)    /* BA=BASE ST=STORE CU=CUSTOMER SE=SEASONAL CL=CLEARANCE */
  2 PRC-STORE-ID          (N4)    /* 0=ALL STORES */
  2 PRC-CUST-TYPE         (A2)    /* CUSTOMER TYPE OR BLANK=ALL */
  2 PRC-PRICE             (N9.2)  /* PRICE AMOUNT */
  2 PRC-COST              (N9.2)  /* COST FOR MARGIN CALC */
  2 PRC-CURRENCY          (A3)    /* CURRENCY CODE */
  2 PRC-EFF-DATE          (D)     /* EFFECTIVE DATE */
  2 PRC-EXP-DATE          (D)     /* EXPIRATION DATE */
  2 PRC-STATUS            (A1)    /* A=ACTIVE I=INACTIVE */
  2 PRC-PRIORITY          (N2)    /* PRICE PRIORITY 1=HIGHEST */
  2 PRC-MIN-QTY           (N6)    /* MINIMUM QUANTITY FOR PRICE */
  2 PRC-MAX-QTY           (N6)    /* MAXIMUM QUANTITY */
  2 PRC-APPROVED-BY       (A8)
  2 PRC-APPROVED-DATE     (D)
*
* PRICE CALCULATION WORK AREA
*
1 PRICE-CALC-WORK
  2 PCW-PROD-ID           (N8)
  2 PCW-SKU               (A15)
  2 PCW-STORE-ID          (N4)
  2 PCW-CUST-ID           (N8)
  2 PCW-CUST-TYPE         (A2)
  2 PCW-QTY               (N6)
  2 PCW-BASE-PRICE        (N9.2)
  2 PCW-STORE-PRICE       (N9.2)  /* STORE OVERRIDE */
  2 PCW-CUST-PRICE        (N9.2)  /* CUSTOMER SPECIFIC */
  2 PCW-SEASONAL-PRICE    (N9.2)  /* SEASONAL */
  2 PCW-PROMO-PRICE       (N9.2)  /* PROMOTIONAL */
  2 PCW-COUPON-DISCOUNT   (N9.2)  /* COUPON */
  2 PCW-QTY-DISCOUNT      (N9.2)  /* QUANTITY DISCOUNT */
  2 PCW-MEMBER-DISCOUNT   (N9.2)  /* MEMBER DISCOUNT */
  2 PCW-CLEARANCE-PRICE   (N9.2)  /* CLEARANCE */
  2 PCW-FINAL-UNIT-PRICE  (N9.2)  /* AFTER ALL ADJUSTMENTS */
  2 PCW-TAX-RATE          (N5.4)
  2 PCW-TAX-AMT           (N9.2)
  2 PCW-FINAL-PRICE       (N9.2)  /* INCLUDING TAX */
  2 PCW-DISCOUNT-TOTAL    (N9.2)  /* TOTAL ALL DISCOUNTS */
  2 PCW-MARGIN            (N9.2)  /* MARGIN AMOUNT */
  2 PCW-MARGIN-PCT        (N5.2)  /* MARGIN PERCENTAGE */
  2 PCW-PRICE-SOURCE      (A2)    /* WHICH PRICE WAS USED */
  2 PCW-PROMO-APPLIED     (A1)    /* Y N */
  2 PCW-COUPON-APPLIED    (A1)    /* Y N */
*
* PROMOTION RECORD
*
1 PROMOTION-DATA
  2 PROM-ID               (N8)    /* PROMOTION IDENTIFIER */
  2 PROM-CODE             (A15)   /* PROMOTION CODE */
  2 PROM-NAME             (A60)
  2 PROM-DESC             (A200)
  2 PROM-TYPE             (A2)    /* PC=PERCENT AM=AMOUNT BG=BOGO FX=FIXED QD=QTY-DISC */
  2 PROM-STATUS           (A1)    /* A=ACTIVE I=INACTIVE P=PENDING E=EXPIRED */
  2 PROM-START-DATE       (D)
  2 PROM-END-DATE         (D)
  2 PROM-PRIORITY         (N2)    /* 1=HIGHEST */
  2 PROM-STACKABLE        (A1)    /* Y=STACKABLE N=NON-STACKABLE */
  2 PROM-VALUE            (N9.2)  /* DISCOUNT VALUE */
  2 PROM-PCT              (N5.2)  /* DISCOUNT PERCENTAGE */
  2 PROM-MAX-DISCOUNT     (N9.2)  /* MAXIMUM DISCOUNT AMOUNT */
  2 PROM-MIN-PURCHASE     (N9.2)  /* MINIMUM PURCHASE AMOUNT */
  2 PROM-MIN-QTY          (N6)    /* MINIMUM QUANTITY */
  2 PROM-MAX-USES         (N6)    /* MAX TOTAL USES */
  2 PROM-CURRENT-USES     (N6)    /* CURRENT USE COUNT */
  2 PROM-MAX-PER-CUST     (N3)    /* MAX USES PER CUSTOMER */
  2 PROM-STORE-ID         (N4)    /* 0=ALL STORES */
  2 PROM-REGION           (A4)    /* BLANK=ALL REGIONS */
*
* PROMOTION ITEM (ELIGIBLE PRODUCTS)
*
1 PROMOTION-ITEM
  2 PI-PROM-ID            (N8)    /* PROMOTION */
  2 PI-APPLY-LEVEL        (A1)    /* P=PRODUCT C=CATEGORY D=DEPARTMENT B=BRAND A=ALL */
  2 PI-PROD-ID            (N8)    /* SPECIFIC PRODUCT */
  2 PI-DEPT               (A4)    /* DEPARTMENT */
  2 PI-CLASS              (A4)    /* CLASS */
  2 PI-BRAND              (A30)   /* BRAND */
  2 PI-EXCLUDE-FLAG       (A1)    /* Y=EXCLUDE THIS ITEM FROM PROMO */
*
* COUPON RECORD
*
1 COUPON-DATA
  2 CPN-CODE              (A15)   /* COUPON CODE */
  2 CPN-PROM-ID           (N8)    /* LINKED PROMOTION */
  2 CPN-TYPE              (A2)    /* PC=PERCENT AM=AMOUNT */
  2 CPN-VALUE             (N9.2)
  2 CPN-PCT               (N5.2)
  2 CPN-STATUS            (A1)    /* A=ACTIVE U=USED E=EXPIRED I=INVALID */
  2 CPN-START-DATE        (D)
  2 CPN-END-DATE          (D)
  2 CPN-CUST-ID           (N8)    /* 0=ANY CUSTOMER */
  2 CPN-SINGLE-USE        (A1)    /* Y=ONE TIME N=MULTI USE */
  2 CPN-MIN-PURCHASE      (N9.2)  /* MINIMUM PURCHASE */
  2 CPN-MAX-DISCOUNT      (N9.2)  /* MAXIMUM DISCOUNT */
  2 CPN-USED-COUNT        (N6)    /* TIMES USED */
  2 CPN-USED-DATE         (D)     /* LAST USED DATE */
*
END-DEFINE
