* >Natural Source Code: PORECV
* SUBPROGRAM: PORECV - PO GOODS RECEIPT
* DESCRIPTION: PROCESSES RECEIPT OF GOODS AGAINST PO
*              UPDATES INVENTORY, PO LINE STATUS,
*              HANDLES PARTIAL AND OVER RECEIPTS
* LIBRARY: RETAILCORE
* ADABAS FILES: 131 (PO-HEADER), 132 (PO-LINE), 105 (INVENTORY)
* CREATED: 2002-01-15  A. GARCIA
* MODIFIED: 2008-09-22 - ADDED PARTIAL RECEIPT
* MODIFIED: 2014-06-10 - ADDED QUALITY CHECK FLAG
* MODIFIED: 2019-11-15 - ADDED OVER-RECEIPT HANDLING
* MODIFIED: 2023-08-10 - ADDED BARCODE VALIDATION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PO-ID               (N10)
  1 P-LINE-NO             (N3)
  1 P-QTY-RECEIVED        (N6)
  1 P-WH-ID               (N4)
  1 P-QUALITY-FLAG        (A1)    /* Y=PASSED N=FAILED P=PENDING */
  1 P-LOT-NUMBER          (A20)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #QTY-ORDERED          (N6)
  1 #QTY-PREV-RECEIVED    (N6)
  1 #QTY-REMAINING        (N6)
  1 #OVER-RECEIPT-PCT     (N5.2)   INIT <10.00>
  1 #OVER-LIMIT           (N6)
  1 #PROD-ID              (N8)
  1 #SKU                  (A15)
  1 #LINE-WH-ID           (N4)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #ORD-STR              (A15)
  1 #ALL-RECEIVED         (A1)
  1 #VALID-FLAG           (A1)
  1 #ERROR-MSG            (A60)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 PRV-VIEW VIEW OF PO-LINE-FILE
    2 PRV-PO-ID            (N10)
    2 PRV-LINE-NO          (N3)
    2 PRV-PROD-ID          (N8)
    2 PRV-SKU              (A15)
    2 PRV-QTY-ORDERED      (N6)
    2 PRV-QTY-RECEIVED     (N6)
    2 PRV-UNIT-COST        (N9.2)
    2 PRV-STATUS           (A2)
    2 PRV-WH-ID            (N4)
*
  1 PRH-VIEW VIEW OF PO-HEADER-FILE
    2 PRH-ID               (N10)
    2 PRH-STATUS           (A2)
    2 PRH-SUPP-ID          (N8)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
*
* VALIDATE PO EXISTS AND IS RECEIVABLE
FIND PRH-VIEW WITH PRH-ID = P-PO-ID
  IF NO RECORDS FOUND
    MOVE 604 TO P-RC
    MOVE 'PURCHASE ORDER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  IF PRH-STATUS NE 'AP' AND PRH-STATUS NE 'SH'
      AND PRH-STATUS NE 'PR'
    MOVE 610 TO P-RC
    COMPRESS 'PO STATUS' PRH-STATUS 'NOT RECEIVABLE' INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  ESCAPE BOTTOM
END-FIND
*
* VALIDATE QTY
IF P-QTY-RECEIVED <= 0
  MOVE 605 TO P-RC
  MOVE 'RECEIVE QUANTITY MUST BE > 0' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* GET PO LINE
FIND PRV-VIEW WITH PRV-PO-ID = P-PO-ID
    AND PRV-LINE-NO = P-LINE-NO
  IF NO RECORDS FOUND
    MOVE 604 TO P-RC
    MOVE 'PO LINE NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
*
  IF PRV-STATUS = 'CA'
    MOVE 611 TO P-RC
    MOVE 'PO LINE IS CANCELLED' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  IF PRV-STATUS = 'RC'
    MOVE 612 TO P-RC
    MOVE 'PO LINE ALREADY FULLY RECEIVED' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  MOVE PRV-QTY-ORDERED  TO #QTY-ORDERED
  MOVE PRV-QTY-RECEIVED TO #QTY-PREV-RECEIVED
  MOVE PRV-PROD-ID      TO #PROD-ID
  MOVE PRV-SKU          TO #SKU
  MOVE PRV-WH-ID        TO #LINE-WH-ID
*
  * USE PO LINE WAREHOUSE OR PARAMETER WAREHOUSE
  IF P-WH-ID = 0
    MOVE #LINE-WH-ID TO P-WH-ID
  END-IF
*
  * CHECK FOR OVER-RECEIPT
  COMPUTE #QTY-REMAINING = #QTY-ORDERED - #QTY-PREV-RECEIVED
  IF P-QTY-RECEIVED > #QTY-REMAINING
    * CHECK OVER-RECEIPT TOLERANCE
    CALLNAT 'CONFIGN' 'PO.OVER.RECEIPT.PCT'
      #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
    IF #CONFIG-FOUND = 'Y'
      MOVE #CONFIG-NUM TO #OVER-RECEIPT-PCT
    END-IF
    COMPUTE #OVER-LIMIT = #QTY-ORDERED
      * (1 + #OVER-RECEIPT-PCT / 100) - #QTY-PREV-RECEIVED
    IF P-QTY-RECEIVED > #OVER-LIMIT
      MOVE 613 TO P-RC
      COMPRESS 'OVER-RECEIPT EXCEEDS TOLERANCE OF'
        #OVER-RECEIPT-PCT '%' INTO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  * UPDATE PO LINE
  GET PRV-VIEW *ISN (HOLD)
  ADD P-QTY-RECEIVED TO PRV-QTY-RECEIVED
  IF PRV-QTY-RECEIVED >= PRV-QTY-ORDERED
    MOVE 'RC' TO PRV-STATUS
  ELSE
    MOVE 'PR' TO PRV-STATUS
  END-IF
  UPDATE PRV-VIEW
*
  * UPDATE INVENTORY (RECEIPT)
  IF P-QUALITY-FLAG NE 'N'
    * QUALITY PASSED OR PENDING - ADD TO INVENTORY
    CALLNAT 'INVUPD'
      #PROD-ID #SKU P-WH-ID 'W' P-QTY-RECEIVED
      'RCPT' 'PO RECEIPT' P-PO-ID P-LINE-NO
      #INV-RC #INV-MSG
    IF #INV-RC NE 0
      CALLNAT 'LOGERR' 301 #INV-MSG 'W' 'PORECV' #USER-ID
    END-IF
  ELSE
    * QUALITY FAILED - ADD AS DAMAGED
    CALLNAT 'INVUPD'
      #PROD-ID #SKU P-WH-ID 'W' P-QTY-RECEIVED
      'DMGD' 'PO RECEIPT QUALITY FAIL' P-PO-ID P-LINE-NO
      #INV-RC #INV-MSG
  END-IF
*
  ESCAPE BOTTOM
END-FIND
*
* CHECK IF ALL LINES RECEIVED
MOVE 'Y' TO #ALL-RECEIVED
FIND PRV-VIEW WITH PRV-PO-ID = P-PO-ID
  IF PRV-STATUS NE 'RC' AND PRV-STATUS NE 'CA'
    MOVE 'N' TO #ALL-RECEIVED
  END-IF
END-FIND
*
IF #ALL-RECEIVED = 'Y'
  CALLNAT 'POVAL' P-PO-ID 'RECV' #USER-ID
    #VALID-FLAG #ERROR-MSG
ELSE
  CALLNAT 'POVAL' P-PO-ID 'PART' #USER-ID
    #VALID-FLAG #ERROR-MSG
END-IF
*
END OF TRANSACTION
*
* UPDATE SUPPLIER PERFORMANCE
FIND PRH-VIEW WITH PRH-ID = P-PO-ID
  CALLNAT 'SUPPUPD' PRH-SUPP-ID 'PERF' ' '
    0 0 0 *DATX 0 ' '
  ESCAPE BOTTOM
END-FIND
*
* CHECK FOR BACKORDERS TO FILL
CALLNAT 'INVBACK' 'CHCK' #PROD-ID #SKU P-WH-ID 'W'
  0 0 0 #INV-RC #INV-MSG
*
* AUDIT
MOVE P-PO-ID TO #ORD-STR
COMPRESS 'LINE' P-LINE-NO 'QTY' P-QTY-RECEIVED INTO #ERROR-MSG
CALLNAT 'AUDITN' 'PO' #ORD-STR 'U' 'RECV'
  ' ' ' ' #ERROR-MSG
*
END
