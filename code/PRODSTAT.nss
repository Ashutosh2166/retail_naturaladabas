* >Natural Source Code: PRODSTAT
* SUBPROGRAM: PRODSTAT - PRODUCT STATUS MANAGEMENT
* DESCRIPTION: MANAGES PRODUCT LIFECYCLE STATUS
* LIBRARY: RETAILCORE
* ADABAS FILE: 101 (PRODUCT)
* CREATED: 2001-02-15  T. ANDERSON
* MODIFIED: 2009-08-20 - ADDED CLEARANCE LOGIC
* MODIFIED: 2018-02-10 - ADDED OPEN ORDER CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROD-ID             (N8)
  1 P-NEW-STATUS          (A1)    /* A I D C */
  1 P-REASON              (A60)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #CURRENT-STATUS       (A1)
  1 #VALID                (A1)
  1 #USER-ID              (A8)
  1 #PROD-STR             (A15)
  1 #OPEN-ORD-COUNT       (N4)
*
  1 PROD-STAT-VIEW VIEW OF PRODUCT-FILE
    2 PR-ID                (N8)
    2 PR-STATUS            (A1)
    2 PR-CLEARANCE-DATE    (D)
    2 PR-DISCO-DATE        (D)
    2 PR-MODIFIED-DATE     (D)
    2 PR-MODIFIED-BY       (A8)
*
  1 ORD-LINE-CHK VIEW OF ORDER-LINE-FILE
    2 OL-PROD-ID           (N8)
    2 OL-STATUS            (A3)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
*
* VALIDATE STATUS CODE
IF P-NEW-STATUS NE 'A' AND P-NEW-STATUS NE 'I'
    AND P-NEW-STATUS NE 'D' AND P-NEW-STATUS NE 'C'
  MOVE 101 TO P-RC
  MOVE 'INVALID PRODUCT STATUS' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* GET CURRENT
FIND PROD-STAT-VIEW WITH PR-ID = P-PROD-ID
  IF NO RECORDS FOUND
    MOVE 100 TO P-RC
    MOVE 'PRODUCT NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE PR-STATUS TO #CURRENT-STATUS
  ESCAPE BOTTOM
END-FIND
*
* VALIDATE TRANSITION
* A->I,D,C  I->A  C->D  D->(NONE)
MOVE 'N' TO #VALID
DECIDE ON FIRST VALUE OF #CURRENT-STATUS
  VALUE 'A'
    IF P-NEW-STATUS = 'I' OR P-NEW-STATUS = 'D'
        OR P-NEW-STATUS = 'C'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'I'
    IF P-NEW-STATUS = 'A'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'C'
    IF P-NEW-STATUS = 'D'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'D'
    * DISCONTINUED IS FINAL
    MOVE 'N' TO #VALID
  NONE VALUE
    MOVE 'N' TO #VALID
END-DECIDE
*
IF #VALID NE 'Y'
  MOVE 406 TO P-RC
  COMPRESS 'INVALID STATUS TRANSITION' #CURRENT-STATUS
    '->' P-NEW-STATUS INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* CHECK OPEN ORDERS BEFORE DISCONTINUE
* MODIFIED 2018-02-10
IF P-NEW-STATUS = 'D'
  RESET #OPEN-ORD-COUNT
  FIND ORD-LINE-CHK WITH OL-PROD-ID = P-PROD-ID
    IF OL-STATUS NE 'CMP' AND OL-STATUS NE 'CAN'
      ADD 1 TO #OPEN-ORD-COUNT
    END-IF
  END-FIND
  IF #OPEN-ORD-COUNT > 0
    MOVE 102 TO P-RC
    COMPRESS 'CANNOT DISCONTINUE -' #OPEN-ORD-COUNT
      'OPEN ORDER LINES' INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
END-IF
*
* APPLY STATUS
FIND PROD-STAT-VIEW WITH PR-ID = P-PROD-ID
  GET PROD-STAT-VIEW *ISN (HOLD)
  MOVE P-NEW-STATUS TO PR-STATUS
  IF P-NEW-STATUS = 'C'
    MOVE *DATX TO PR-CLEARANCE-DATE
  END-IF
  IF P-NEW-STATUS = 'D'
    MOVE *DATX TO PR-DISCO-DATE
  END-IF
  MOVE *DATX    TO PR-MODIFIED-DATE
  MOVE #USER-ID TO PR-MODIFIED-BY
  UPDATE PROD-STAT-VIEW
  ESCAPE BOTTOM
END-FIND
*
END OF TRANSACTION
*
MOVE P-PROD-ID TO #PROD-STR
CALLNAT 'AUDITN' 'PROD' #PROD-STR 'U' 'STATUS'
  #CURRENT-STATUS P-NEW-STATUS P-REASON
*
END
